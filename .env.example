# ==============================================================================
# SOCIAL GROWTH AI - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to .env and replace placeholder values with your credentials.
# NEVER commit real API keys, signing keys, or production database passwords to Git.

# --- SERVER & DEPLOYMENT ---
PORT=3000
NODE_ENV=development
APP_URL="http://localhost:3000"
SESSION_SECRET="your-cryptographically-random-64-byte-session-secret-here"

# --- DATABASE (POSTGRESQL + PRISMA) ---
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://postgres:postgres_password@localhost:5432/socialgrowth_db?schema=public"

# --- AI PROVIDER (GEMINI API) ---
# AI Studio automatically injects this at runtime from user secrets.
# Used for captions, viral hooks, full scripts, and organic growth playbooks.
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"

# --- PLATFORM ADAPTER 1: INSTAGRAM GRAPH API ---
# Registered Meta App with instagram_basic, instagram_manage_insights permissions
INSTAGRAM_ACCESS_TOKEN="your_instagram_user_access_token_here"
META_APP_SECRET="your_meta_app_secret_here"

# --- PLATFORM ADAPTER 2: YOUTUBE DATA API V3 ---
# Google Cloud Console -> Enable YouTube Data API v3 -> Generate Server API Key
YOUTUBE_API_KEY="AIzaSyYourYouTubeDataApiKeyHere"

# --- PLATFORM ADAPTER 3: TIKTOK DISPLAY & RESEARCH API ---
# TikTok for Developers -> App Key and Client Secret
TIKTOK_CLIENT_KEY="your_tiktok_client_key_here"
TIKTOK_CLIENT_SECRET="your_tiktok_client_secret_here"

# --- PLATFORM ADAPTER 4: FACEBOOK PAGES API ---
# Meta Graph API Page Access Token with pages_read_engagement permissions
META_PAGE_ACCESS_TOKEN="your_facebook_page_access_token_here"

# --- PLATFORM ADAPTER 5: X / TWITTER API V2 ---
# Developer Portal -> Project Bearer Token
X_BEARER_TOKEN="your_x_api_v2_bearer_token_here"

# --- ANDROID RELEASE SIGNING (CI / CD SECRETS ONLY) ---
# Kept in GitHub Actions Repository Secrets, never in source control.
ANDROID_KEYSTORE_BASE64=""
ANDROID_KEYSTORE_PASSWORD=""
ANDROID_KEY_ALIAS=""
ANDROID_KEY_PASSWORD=""
